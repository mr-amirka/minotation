{
  "name": "minotation",
  "version": "0.0.1",
  "description": "Minotation — CSS generation from compact notation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix --quiet",
    "test": "jest --no-coverage",
    "test:watch": "jest --watch --no-coverage",
    "test:coverage": "jest --coverage",
    "test:dist": "npm run build && node scripts/smoke-dist.js",
    "validate": "npm run lint && npm run test"
  },
  "dependencies": {
    "fundamentool": "1.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "fast-check": "^4.8.0",
    "jest": "^29.0.0",
    "postcss": "^8.5.15",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
