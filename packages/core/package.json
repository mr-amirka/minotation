{
  "name": "minotation",
  "version": "0.0.1",
  "description": "Minotation — CSS generation from compact notation",
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/browser/index.mjs",
        "default": "./dist/index.js"
      },
      "import": "./dist/esm/index.mjs",
      "default": "./dist/index.js"
    },
    "./mne": {
      "types": "./dist/mne.d.ts",
      "browser": {
        "import": "./dist/browser/mne.mjs",
        "default": "./dist/mne.js"
      },
      "import": "./dist/esm/mne.mjs",
      "default": "./dist/mne.js"
    },
    "./syntax": {
      "types": "./dist/syntaxScan.d.ts",
      "import": "./dist/esm/syntaxScan.mjs",
      "default": "./dist/syntaxScan.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-esm.mjs",
    "prepare": "tsc -p tsconfig.build.json && node scripts/build-esm.mjs",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix --quiet",
    "test": "jest --no-coverage",
    "test:watch": "jest --watch --no-coverage",
    "test:coverage": "jest --coverage",
    "test:dist": "pnpm build && node scripts/smoke-dist.js",
    "validate": "npm run lint && npm run test",
    "try": "node scripts/try.mjs"
  },
  "dependencies": {
    "fundamentool": "workspace:*"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/jest": "^29.0.0",
    "css-tree": "^3.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.9.1",
    "eslint-config-lab": "github:mr-amirka/eslint-config-lab#9238feb561678405da80afe8ce7dfc379a7160b5",
    "fast-check": "^4.8.0",
    "jest": "^29.0.0",
    "modern-normalize-1.1.0": "npm:modern-normalize@1.1.0",
    "modern-normalize-2.0.0": "npm:modern-normalize@2.0.0",
    "modern-normalize-3.0.1": "npm:modern-normalize@3.0.1",
    "normalize.css-3.0.3": "npm:normalize.css@3.0.3",
    "normalize.css-4.2.0": "npm:normalize.css@4.2.0",
    "normalize.css-5.0.0": "npm:normalize.css@5.0.0",
    "normalize.css-6.0.0": "npm:normalize.css@6.0.0",
    "normalize.css-7.0.0": "npm:normalize.css@7.0.0",
    "normalize.css-8.0.1": "npm:normalize.css@8.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
