{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "strict": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "types": [
      "node",
      "jest"
    ],
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.tmp.*"
  ],
  "include": [
    "src/**/*"
  ]
}
