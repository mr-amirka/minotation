{
  "name": "minotation-cli",
  "version": "0.0.1",
  "description": "Command-line compiler for Minimalist Notation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mn": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "jest --config=./jest.config.js --no-coverage",
    "test:watch": "jest --watch --no-coverage --config=./jest.config.js",
    "test:coverage": "jest --coverage --config=./jest.config.js",
    "validate": "pnpm run lint && pnpm run test:coverage"
  },
  "peerDependencies": {
    "minotation": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "minotation-build": "workspace:*"
  }
}
