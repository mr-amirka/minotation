{
  "name": "minotation-esbuild",
  "version": "0.0.1",
  "description": "esbuild plugin for Minimalist Notation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --config=./jest.config.js --no-coverage",
    "test:watch": "jest --watch --no-coverage --config=./jest.config.js",
    "test:coverage": "jest --coverage --config=./jest.config.js"
  },
  "peerDependencies": {
    "esbuild": "^0.19.0 || ^0.20.0 || ^0.21.0 || ^0.22.0 || ^0.23.0 || ^0.24.0 || ^0.25.0 || ^0.26.0 || ^0.27.0 || ^0.28.0",
    "minotation": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  }
}
