{
  "name": "minotation-rollup",
  "version": "0.0.1",
  "description": "Rollup plugin for Minimalist Notation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --config=./jest.config.js --no-coverage",
