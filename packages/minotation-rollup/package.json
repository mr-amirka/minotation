    "test:coverage": "jest --coverage --config=./jest.config.js"
  },
  "dependencies": {
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "minotation": "workspace:*",
    "rollup": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "rollup": "^4",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  }
}
