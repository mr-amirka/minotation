{
  "name": "minotation-runtime-angular",
  "version": "0.0.1",
  "description": "Angular adapter for minotation-runtime — lifecycle wiring for the framework-agnostic DOM runtime",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "test": "jest --config=./jest.config.js --no-coverage",
    "test:watch": "jest --watch --no-coverage --config=./jest.config.js",
    "test:coverage": "jest --coverage --config=./jest.config.js"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0",
    "minotation": "workspace:*",
    "minotation-runtime": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "^20.3.32",
    "@angular/compiler": "^20.3.32",
    "@angular/compiler-cli": "^20.3.32",
    "@angular/core": "^20.3.32",
    "@angular/platform-browser": "^20.3.32",
    "@angular/platform-browser-dynamic": "^20.3.32",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.5.5",
    "ng-packagr": "^20.3.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.0.0",
    "zone.js": "~0.15.0"
  }
}
