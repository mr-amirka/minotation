{
  "name": "minotation-webpack",
  "version": "2.0.0",
  "description": "Webpack loader + plugin for Minimalist Notation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --config=./jest.config.js --no-coverage",
    "test:watch": "jest --watch --no-coverage --config=./jest.config.js",
    "test:coverage": "jest --coverage --config=./jest.config.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "minotation": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5",
    "webpack": "^5"
  },
  "peerDependencies": {
    "webpack": "^5"
  }
}
