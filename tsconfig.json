{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "strict": false,
    "noImplicitAny": false
  },
  "exclude": ["node_modules", "dist", "**/*.tmp.*"],
  "include": ["src/**/*"]
}
